# Copy to .env or export these variables before running scripts.
export MECHPARSER_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export MECHPARSER_DATA_ROOT="$MECHPARSER_ROOT/data"
export MECHPARSER_OUTPUT_ROOT="$MECHPARSER_ROOT/outputs"
export MECHPARSER_BASE_MODEL="Qwen/Qwen3-VL-4B-Instruct"

# Optional explicit overrides. Defaults follow DATA_ROOT/{stage1,stage2,real}.
# export MECHPARSER_STAGE1_TRAIN=/path/to/arrow_train.json
# export MECHPARSER_STAGE1_EVAL=/path/to/arrow_eval.json
# export MECHPARSER_STAGE1_IMAGES=/path/to/images
# export MECHPARSER_STAGE2_TRAIN=/path/to/arrow_train.json
# export MECHPARSER_STAGE2_EVAL=/path/to/arrow_eval.json
# export MECHPARSER_STAGE2_IMAGES=/path/to/images
# export MECHPARSER_STAGE3A_TRAIN=/path/to/mixed_train.json
# export MECHPARSER_STAGE3B_TRAIN=/path/to/grpo_train.json
# export MECHPARSER_REAL_EVAL=/path/to/real_eval.json
# export MECHPARSER_REAL_IMAGES=/path/to/images

# Cluster-specific submission settings. Set ACCOUNT and the partition names to
# match your scheduler; the GRES values reproduce the 6x RTX 5880 setup used for
# every training stage in the paper.
export MECHPARSER_ACCOUNT="your-slurm-account"
export MECHPARSER_STAGE1_PARTITION="gpu-rtx5880"
export MECHPARSER_STAGE1_GRES="gpu:rtx5880:6"
export MECHPARSER_STAGE2_PARTITION="gpu-rtx5880"
export MECHPARSER_STAGE2_GRES="gpu:rtx5880:6"
export MECHPARSER_STAGE3A_PARTITION="gpu-rtx5880"
export MECHPARSER_STAGE3A_GRES="gpu:rtx5880:6"
export MECHPARSER_STAGE3B_PARTITION="gpu-rtx5880"
export MECHPARSER_STAGE3B_GRES="gpu:rtx5880:6"
# Merging LoRA adapters is single-GPU and is not one of the training stages.
export MECHPARSER_MERGE_PARTITION="gpu-rtx5880"
export MECHPARSER_MERGE_GRES="gpu:rtx5880:1"

# Keep final test data out of training by default.
export MECHPARSER_ENABLE_TRAIN_EVAL=0